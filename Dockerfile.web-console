FROM maven:3.9.15-eclipse-temurin-26@sha256:029a8e2838ae68238ffb8be407cddbb3f07d4d839c60c6f26c619a69fd184531 AS build

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

WORKDIR /workspace

COPY web-console/pom.xml .
RUN mvn -B -ntp dependency:go-offline

COPY web-console/frontend ./frontend
COPY web-console/src ./src
RUN mvn -B -ntp verify

FROM eclipse-temurin:21-jre@sha256:d2b9f8f12212cadcfdf889461531784e8fd097feade954d65b31ee7a71c473ec

WORKDIR /app

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Cluster Infra RCA Platform" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/nembutal-sw/kubernetes-cluster-infra-rca-platform"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && groupadd --gid 65532 rca \
    && useradd --uid 65532 --gid 65532 --create-home --shell /usr/sbin/nologin rca \
    && mkdir -p /app/data \
    && chown -R 65532:65532 /app \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/cluster-infra-rca-platform-0.1.0.jar /app/platform.jar

EXPOSE 8080

USER 65532:65532

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl --fail --silent http://127.0.0.1:8080/health/ready || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/platform.jar"]
