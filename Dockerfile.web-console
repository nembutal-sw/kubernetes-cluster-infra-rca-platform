FROM maven:3.9.9-eclipse-temurin-17 AS build

WORKDIR /workspace

COPY web-console/pom.xml .
RUN mvn -B -ntp dependency:go-offline

COPY web-console/src ./src
RUN mvn -B -ntp package -DskipTests

FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=build /workspace/target/cluster-infra-rca-web-console-0.1.0.war /app/web-console.war

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/web-console.war"]
