[
  {
    "name": "storage promotes node readiness symptom",
    "current_alert": "NodeNotReady",
    "current_components": ["node"],
    "incoming_alert": "DiskPressure",
    "incoming_components": ["disk"],
    "current_status": "open",
    "expected_match": true,
    "expected_recurrence": false,
    "expected_promotion": true,
    "expected_rule": "storage_node"
  },
  {
    "name": "runtime propagates to kubelet",
    "current_alert": "ContainerdDown",
    "current_components": ["runtime"],
    "incoming_alert": "KubeletDown",
    "incoming_components": ["kubelet"],
    "current_status": "open",
    "expected_match": true,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "runtime_kubelet"
  },
  {
    "name": "conntrack propagates to dns",
    "current_alert": "NetworkUnavailable",
    "current_components": ["conntrack"],
    "incoming_alert": "CoreDNSLatencyHigh",
    "incoming_components": ["dns"],
    "current_status": "open",
    "expected_match": true,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "conntrack_dns"
  },
  {
    "name": "etcd propagates to api server",
    "current_alert": "EtcdLatencyHigh",
    "current_components": ["etcd"],
    "incoming_alert": "APIServerLatencyHigh",
    "incoming_components": ["api_server"],
    "current_status": "open",
    "expected_match": true,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "etcd_api_server"
  },
  {
    "name": "network propagates to cni",
    "current_alert": "NetworkUnavailable",
    "current_components": ["network"],
    "incoming_alert": "CNIFailure",
    "incoming_components": ["cni"],
    "current_status": "open",
    "expected_match": true,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "network_cni"
  },
  {
    "name": "storage and dns remain separate",
    "current_alert": "DiskPressure",
    "current_components": ["disk", "kernel", "systemd"],
    "incoming_alert": "CoreDNSLatencyHigh",
    "incoming_components": ["dns", "kernel", "systemd"],
    "current_status": "open",
    "expected_match": false,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "new_incident"
  },
  {
    "name": "memory and etcd remain separate",
    "current_alert": "MemoryPressure",
    "current_components": ["memory"],
    "incoming_alert": "EtcdLatencyHigh",
    "incoming_components": ["etcd"],
    "current_status": "open",
    "expected_match": false,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "new_incident"
  },
  {
    "name": "kubelet and dns remain separate",
    "current_alert": "KubeletDown",
    "current_components": ["kubelet"],
    "incoming_alert": "CoreDNSUnhealthy",
    "incoming_components": ["dns"],
    "current_status": "open",
    "expected_match": false,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "new_incident"
  },
  {
    "name": "process pressure and api server remain separate",
    "current_alert": "PIDPressure",
    "current_components": ["process"],
    "incoming_alert": "APIServerLatencyHigh",
    "incoming_components": ["api_server"],
    "current_status": "open",
    "expected_match": false,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "new_incident"
  },
  {
    "name": "same resolved disk alert is recurrence",
    "current_alert": "DiskPressure",
    "current_components": ["disk"],
    "incoming_alert": "DiskPressure",
    "incoming_components": ["inode"],
    "current_status": "resolved",
    "expected_match": false,
    "expected_recurrence": true,
    "expected_promotion": false,
    "expected_rule": "incident_recurrence_same_alert"
  },
  {
    "name": "same resolved signal family is recurrence",
    "current_alert": "DiskPressure",
    "current_components": ["disk"],
    "incoming_alert": "FilesystemLatencyHigh",
    "incoming_components": ["storage"],
    "current_status": "resolved",
    "expected_match": false,
    "expected_recurrence": true,
    "expected_promotion": false,
    "expected_rule": "incident_recurrence_same_family"
  },
  {
    "name": "resolved storage does not absorb kubelet symptom",
    "current_alert": "DiskPressure",
    "current_components": ["disk"],
    "incoming_alert": "KubeletDown",
    "incoming_components": ["kubelet"],
    "current_status": "resolved",
    "expected_match": false,
    "expected_recurrence": false,
    "expected_promotion": false,
    "expected_rule": "new_incident"
  }
]
