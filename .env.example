# Pick one database URL.
#
# PostgreSQL:
# RCA_DATABASE_URL=postgresql+psycopg://rca:rca_password@localhost:5432/rca
#
# MariaDB:
# RCA_DATABASE_URL=mysql+pymysql://rca:rca_password@localhost:3306/rca
#
# Local fallback for development without Docker:
# RCA_DATABASE_URL=sqlite:///./data/rca-dev.db

# Keep false for migration-managed databases.
# Tests can override this explicitly.
RCA_AUTO_CREATE_TABLES=false

# Docker backend entrypoint runs Alembic migrations before starting the API.
RCA_RUN_MIGRATIONS=true

# Initial administrator account.
# Change the password from the Web Console after first login.
RCA_DEFAULT_ADMIN_USERNAME=admin
RCA_DEFAULT_ADMIN_PASSWORD=admin

# Used by Alertmanager and other webhook senders.
# Prefer Authorization: Bearer <token>; X-Webhook-Token is also accepted.
RCA_WEBHOOK_TOKEN=dev-webhook-token

# Login session lifetime in hours. Values are clamped to 1-168.
RCA_SESSION_TTL_HOURS=12

# Node agents are reported offline after this many seconds without a heartbeat.
# Values are clamped to 30-86400.
RCA_AGENT_OFFLINE_AFTER_SECONDS=180

# Public API URL copied into web console install commands.
# Use the backend URL reachable from kubectl workstations and node agents.
RCA_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM Analyzer is disabled unless explicitly configured.
# Providers: disabled, openai, anthropic, gemini, openai_compatible, self_hosted
RCA_LLM_PROVIDER=disabled
# RCA_LLM_MODEL=
# RCA_LLM_API_KEY=
# RCA_LLM_BASE_URL=
# Timeout is clamped to 1-120 seconds.
RCA_LLM_TIMEOUT_SECONDS=20
# Output token budget is clamped to 128-8000.
RCA_LLM_MAX_OUTPUT_TOKENS=1200
