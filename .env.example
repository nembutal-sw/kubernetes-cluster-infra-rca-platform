# Pick one database URL.
#
# PostgreSQL:
# RCA_DATABASE_URL=postgresql+psycopg://rca:rca_password@localhost:5432/rca
#
# MariaDB:
# RCA_DATABASE_URL=mysql+pymysql://rca:rca_password@localhost:3306/rca
#
# Local fallback for development without Docker:
RCA_DATABASE_URL=sqlite:///./data/rca-dev.db

# Keep false for migration-managed databases.
# Tests can override this explicitly.
RCA_AUTO_CREATE_TABLES=false

# Used by the Web UI admin approval queue.
# Replace this in any shared environment.
RCA_ADMIN_APPROVAL_TOKEN=dev-admin-approval-token

# LLM Analyzer is disabled unless explicitly configured.
# Providers: disabled, openai, anthropic, gemini, openai_compatible, self_hosted
RCA_LLM_PROVIDER=disabled
# RCA_LLM_MODEL=
# RCA_LLM_API_KEY=
# RCA_LLM_BASE_URL=
RCA_LLM_TIMEOUT_SECONDS=20
RCA_LLM_MAX_OUTPUT_TOKENS=1200
