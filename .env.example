# PostgreSQL
RCA_JDBC_URL=jdbc:postgresql://postgres:5432/rca
RCA_DB_USERNAME=rca
RCA_DB_PASSWORD=rca_password

# MariaDB example
# RCA_JDBC_URL=jdbc:mariadb://mariadb:3306/rca

RCA_DEFAULT_ADMIN_USERNAME=
RCA_DEFAULT_ADMIN_PASSWORD=
RCA_WEBHOOK_TOKEN=
RCA_STANDARD_REQUEST_MAX_BYTES=1048576
RCA_EVIDENCE_REQUEST_MAX_BYTES=10485760
RCA_MANIFEST_TOKEN_TTL_SECONDS=300
RCA_AGENT_MTLS_REQUIRED=false
RCA_SESSION_TTL_HOURS=12
RCA_AGENT_OFFLINE_AFTER_SECONDS=180
RCA_AGENT_EXPECTED_VERSION=
RCA_AGENT_MINIMUM_SUPPORTED_VERSION=0.1.0
RCA_AGENT_PROTOCOL_VERSION=1
RCA_AGENT_MINIMUM_SUPPORTED_PROTOCOL_VERSION=1
RCA_PLATFORM_VERSION=0.1.0
RCA_PUBLIC_API_BASE_URL=http://localhost:8080
RCA_AUDIT_ENABLED=true
RCA_ENCRYPTION_SECRET=
RCA_DEMO_ENABLED=false
RCA_EXPORT_MAX_BUNDLE_BYTES=10485760
RCA_NOTIFICATION_ENABLED=false
RCA_SLACK_WEBHOOK_URL=
RCA_NOTIFICATION_MINIMUM_SEVERITY=critical
RCA_NOTIFICATION_MAX_ATTEMPTS=2
RCA_NOTIFICATION_TIMEOUT_SECONDS=5
SPRING_PROFILES_ACTIVE=

# Optional periodic evidence collection without Prometheus or Alertmanager.
RCA_MONITORING_ENABLED=false
RCA_MONITORING_INTERVAL_MS=60000
RCA_OBSERVABILITY_ENABLED=true
RCA_METRICS_TOKEN=
RCA_OBSERVABILITY_REFRESH_INTERVAL_MS=15000
RCA_OBSERVABILITY_INITIAL_DELAY_MS=5000

# Spring AI is disabled by default.
# Chat model values: openai-sdk, anthropic, google-genai, ollama, none
RCA_LLM_ENABLED=false
RCA_LLM_PROVIDER=none
RCA_LLM_MODEL=
RCA_SPRING_AI_CHAT_MODEL=none
RCA_LLM_TIMEOUT_SECONDS=30
RCA_LLM_MAX_ATTEMPTS=2
RCA_LLM_FAILURE_THRESHOLD=3
RCA_LLM_COOLDOWN_SECONDS=60
RCA_INCIDENT_CORRELATION_WINDOW_MINUTES=15
RCA_INCIDENT_CORRELATION_MINIMUM_SCORE=70
RCA_INCIDENT_CORRELATION_CANDIDATE_LIMIT=20
RCA_INCIDENT_AUTO_RESOLVE_ENABLED=true
RCA_INCIDENT_INACTIVITY_MINUTES=60
RCA_INCIDENT_LIFECYCLE_SCAN_INTERVAL_MS=60000
RCA_INCIDENT_LIFECYCLE_INITIAL_DELAY_MS=30000
RCA_INCIDENT_LIFECYCLE_BATCH_SIZE=100
RCA_INCIDENT_RECURRENCE_LOOKBACK_HOURS=168
RCA_TOPOLOGY_ENABLED=true
RCA_TOPOLOGY_LOOKBACK_HOURS=24
RCA_TOPOLOGY_OBSERVATION_LIMIT=500
RCA_AUDIT_RETENTION_DAYS=180
RCA_MAINTENANCE_ENABLED=true
RCA_MAINTENANCE_CRON="0 17 3 * * *"
RCA_MAINTENANCE_BATCH_SIZE=250
RCA_EVIDENCE_RETENTION_DAYS=30
RCA_EVIDENCE_REQUEST_RETENTION_DAYS=30
RCA_ANALYSIS_TASK_RETENTION_DAYS=30
RCA_REALTIME_EVENT_RETENTION_DAYS=14
RCA_TOPOLOGY_OBSERVATION_RETENTION_DAYS=30
RCA_REPORT_RETENTION_DAYS=365
RCA_PIPELINE_ENABLED=true
RCA_PIPELINE_BATCH_SIZE=4
RCA_PIPELINE_POLL_INTERVAL_MS=2000
RCA_PIPELINE_LEASE_SECONDS=300
RCA_PIPELINE_MAX_ATTEMPTS=5
RCA_PIPELINE_RETRY_BASE_SECONDS=5
RCA_PIPELINE_RETRY_MAX_SECONDS=300

# Provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
