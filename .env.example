# Pick one database URL.
#
# PostgreSQL:
# RCA_DATABASE_URL=postgresql+psycopg://rca:rca_password@localhost:5432/rca
#
# MariaDB:
# RCA_DATABASE_URL=mysql+pymysql://rca:rca_password@localhost:3306/rca
#
# Local fallback for development without Docker:
RCA_DATABASE_URL=sqlite:///./data/rca-dev.db

# MVP mode creates tables automatically on startup.
# Later this should be replaced by Alembic migrations.
RCA_AUTO_CREATE_TABLES=true
